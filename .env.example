# Clikchat SaaS Multi-Tenant Configuration Template
PORT=4000
NODE_ENV=production

# Database (Neon Serverless Postgres / Supabase / PostgreSQL)
DATABASE_URL=postgresql://usuario:password@ep-host.aws.neon.tech/neondb?sslmode=require

# Multi-LLM Providers
OPENROUTER_API_KEY=your_openrouter_api_key_here
GOOGLE_AI_STUDIO_KEY=your_google_ai_studio_key_here

# Cloudflare Pages / Deployment
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CF_PAGES_DOMAIN=Clikchat.pages.dev

# Security & Sessions
JWT_SECRET=your_jwt_secret
