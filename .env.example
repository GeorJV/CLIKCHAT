# Clikchat SaaS Multi-Tenant Configuration Template
PORT=4000
NODE_ENV=production

# Cloudflare D1 Native Database
CF_D1_DATABASE_ID=your_cloudflare_d1_database_id
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CF_PAGES_DOMAIN=clikchat.pages.dev

# Multi-LLM Providers
OPENROUTER_API_KEY=your_openrouter_api_key_here
GOOGLE_AI_STUDIO_KEY=your_google_ai_studio_key_here

# Security & Sessions
JWT_SECRET=your_jwt_secret
